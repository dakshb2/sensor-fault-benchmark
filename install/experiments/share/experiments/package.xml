<?xml version="1.0"?>
<package format="3">
  <name>experiments</name>
  <version>0.1.0</version>
  <description>Fixed trajectory driver, run scripts, and pinned baselines. Drives on simulation time so runs are identical across hardware.</description>
  <maintainer email="dakshb2@illinois.edu">Daksh Bhaskar</maintainer>
